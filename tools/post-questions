#!/usr/bin/env node
// Posts the questions from an epic check on each issue that has some, and labels those issues.
// Input (stdin): the check's output, one section per issue:
//   ### #75
//   **Q1. …** … **Recommendation:** …
//   ### #76
//   NO_QUESTIONS
// Env: FACTORY_VAR_GITHUB_REPO, FACTORY_VAR_ISSUES (the issues that were checked),
//      FACTORY_VAR_NEEDS_INFO_LABEL (label for issues with questions), FACTORY_RUN_ID,
//      FACTORY_NEXT_QUESTIONS (the closing sentence of the comment).
import { execFileSync } from "node:child_process";
import { readFileSync } from "node:fs";

const repo = process.env.FACTORY_VAR_GITHUB_REPO;
if (!repo || !/^[\w.-]+\/[\w.-]+$/.test(repo)) fail("set var github_repo to owner/repo");
const next = process.env.FACTORY_NEXT_QUESTIONS;
const label = process.env.FACTORY_VAR_NEEDS_INFO_LABEL || "factory:needs-info";
const checked = new Set((process.env.FACTORY_VAR_ISSUES ?? "").split(/[\s,]+/).filter((x) => /^\d+$/.test(x)));
const gh = (args, input) => execFileSync(process.env.FACTORY_GH_BIN || "gh", args, { encoding: "utf8", input, stdio: [input ? "pipe" : "ignore", "pipe", "pipe"] });

function fail(msg) {
  console.error(`post-questions: ${msg}`);
  process.exit(1);
}

const text = readFileSync(0, "utf8");
const sections = new Map();
let current;
for (const line of text.split("\n")) {
  const m = /^#{2,4}\s*#(\d+)\b/.exec(line);
  if (m) {
    current = m[1];
    sections.set(current, []);
  } else if (current) sections.get(current).push(line);
}
if (!sections.size) fail("no '### #N' sections in the output");

let asked = 0;
for (const [n, lines] of sections) {
  if (!checked.has(n)) continue; // only issues that were part of this check
  const body = lines.join("\n").trim();
  if (!body || /^NO_QUESTIONS\b/m.test(body)) {
    console.log(`#${n}: no questions`);
    continue;
  }
  const comment = [
    "🤖 **Spaghetti Code Foundry** has questions before it builds this issue (asked up front for all issues in this batch):",
    "",
    body,
    "",
    ...(next ? [`_${next}_`, ""] : []),
    `<!-- claude-factory run=${process.env.FACTORY_RUN_ID ?? ""} questions -->`,
  ].join("\n");
  gh(["issue", "comment", n, "--repo", repo, "--body-file", "-"], comment);
  gh(["issue", "edit", n, "--repo", repo, "--add-label", label]);
  console.log(`#${n}: asked (${(body.match(/^\*\*Q\d+/gm) ?? []).length || "some"} questions)`);
  asked++;
}
console.log(`QUESTIONS: ${asked}`);
