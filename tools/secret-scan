#!/usr/bin/env node
// Scan the lines added by some commits for secrets. Exit 1 (and list findings, masked) if any.
// Usage: secret-scan <git rev-list args>      e.g.  secret-scan origin/main..HEAD
//        secret-scan                          (default: commits not on any remote)
// Allow a finding: put `factory:allow-secret` on the line, or a regex per line in
// .claude-factory/secret-allow (matched against "file:line: text").
import { execFileSync } from "node:child_process";
import { existsSync, readFileSync } from "node:fs";

const RULES = [
  ["private key", /-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY-----/],
  ["AWS access key", /\b(?:AKIA|ASIA)[0-9A-Z]{16}\b/],
  ["AWS secret key", /aws_secret_access_key\s*[:=]\s*["']?[A-Za-z0-9/+=]{40}/i],
  ["GitHub token", /\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{50,})\b/],
  ["Anthropic key", /\bsk-ant-[A-Za-z0-9_-]{20,}/],
  ["OpenAI key", /\bsk-(?:proj-|svcacct-)?[A-Za-z0-9_-]{32,}/],
  ["Slack token", /\bxox[abposr]-[A-Za-z0-9-]{10,}/],
  ["Slack webhook", /hooks\.slack\.com\/services\/T[A-Z0-9]+\/B[A-Z0-9]+\/[A-Za-z0-9]+/],
  ["Google API key", /\bAIza[0-9A-Za-z_-]{35}\b/],
  ["Stripe live key", /\b(?:sk|rk)_live_[0-9a-zA-Z]{20,}/],
  ["npm token", /\bnpm_[A-Za-z0-9]{36}\b/],
  ["Linear key", /\blin_api_[A-Za-z0-9]{40}\b/],
  ["connection string with password", /\b(?:postgres(?:ql)?|mysql|mongodb(?:\+srv)?|redis|amqp):\/\/[^\s:/@]+:[^\s@/]{6,}@/],
  ["hard-coded secret", /\b(?:password|passwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token|client[_-]?secret)\b["']?\s*[:=]\s*["']([^"'\s]{12,})["']/i],
];
// Obvious placeholders in the generic rule.
// A PEM header only counts when key data follows it (on the line, or within the next 3 added
// lines); code that writes a header around a key generated at runtime is not a leak.
const KEY_DATA = /[A-Za-z0-9+/]{40,}={0,2}/;
const PLACEHOLDER = /^(?:x+|\*+|changeme|example|placeholder|your[_-]|<|\$\{|\{\{|process\.env|os\.environ|test|dummy|fake|redacted)/i;
const RISKY_FILE = /(?:^|\/)(?:\.env(?:\.[\w-]+)?|id_(?:rsa|dsa|ecdsa|ed25519)|[^/]+\.(?:pem|p12|pfx|key|keystore|jks))$/;
const SAFE_FILE = /\.(?:example|sample|template|dist)$|\.env\.(?:example|sample|template)$|\.pub$/;

// secret-scan --text: reads text on stdin, prints it with everything that looks like a secret replaced by "[removed]".
// It needs no git repository and exits 0.
if (process.argv[2] === "--text") {
  let text = readFileSync(0, "utf8");
  text = text.replace(/-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY-----[\s\S]*?(?:-----END (?:RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY-----|$)/g, "[removed]");
  for (const [, re] of RULES) text = text.replace(new RegExp(re.source, re.flags.includes("i") ? "gi" : "g"), "[removed]");
  process.stdout.write(text);
  process.exit(0);
}

const git = (...a) => execFileSync("git", a, { encoding: "utf8", maxBuffer: 256 * 1024 * 1024 });
const range = process.argv.slice(2);
const revs = range.length ? range : ["HEAD", "--not", "--remotes"];

const allow = existsSync(".claude-factory/secret-allow")
  ? readFileSync(".claude-factory/secret-allow", "utf8").split("\n").map((l) => l.trim()).filter((l) => l && !l.startsWith("#")).map((l) => new RegExp(l))
  : [];
const mask = (s) => (s.length <= 8 ? "****" : `${s.slice(0, 4)}…${s.slice(-2)} (${s.length} chars)`);

let patch;
try {
  patch = git("log", "-p", "--no-color", "--no-ext-diff", "--unified=0", "--format=commit %h", ...revs);
} catch (e) {
  console.error(`secret-scan: git log failed: ${e.message.split("\n")[0]}`);
  process.exit(2);
}

const findings = [];
let file = "";
let commit = "";
let line = 0;
let pemPending; // { finding, file, left }
for (const raw of patch.split("\n")) {
  if (pemPending && (!raw.startsWith("+") || raw.startsWith("+++"))) {
    if (raw.startsWith("commit ") || raw.startsWith("+++ ")) pemPending = undefined;
  }
  if (raw.startsWith("commit ")) commit = raw.slice(7);
  else if (raw.startsWith("+++ ")) {
    file = raw.startsWith("+++ b/") ? raw.slice(6) : "";
    if (file && RISKY_FILE.test(file) && !SAFE_FILE.test(file)) findings.push({ commit, where: file, rule: "sensitive file", text: "" });
  } else if (raw.startsWith("@@")) {
    line = Number(/\+(\d+)/.exec(raw)?.[1] ?? 0);
  } else if (raw.startsWith("+") && file) {
    const text = raw.slice(1);
    if (pemPending && pemPending.file === file) {
      if (KEY_DATA.test(text)) {
        findings.push(pemPending.finding);
        pemPending = undefined;
      } else if (--pemPending.left <= 0) pemPending = undefined;
    }
    for (const [rule, re] of RULES) {
      const m = re.exec(text);
      if (!m) continue;
      const value = m[1] ?? m[0];
      if (rule === "hard-coded secret" && (PLACEHOLDER.test(value) || !/[0-9]/.test(value) || !/[A-Za-z]/.test(value))) continue;
      const where = `${file}:${line}`;
      if (text.includes("factory:allow-secret") || allow.some((a) => a.test(`${where}: ${text}`))) continue;
      if (rule === "private key" && !KEY_DATA.test(text.slice(m.index + m[0].length))) {
        pemPending = { finding: { commit, where, rule, text: mask(value) }, file, left: 3 };
        break;
      }
      findings.push({ commit, where, rule, text: mask(value) });
      break;
    }
    line++;
  }
}

// Report each file:rule once (the same secret often appears in several commits).
const seen = new Set();
const unique = findings.filter((f) => !seen.has(`${f.where}|${f.rule}`) && seen.add(`${f.where}|${f.rule}`));
if (!unique.length) {
  console.log("secret-scan: no secrets found");
  process.exit(0);
}
console.error(`secret-scan: ${unique.length} possible secret(s) in the commits being pushed:`);
for (const f of unique) console.error(`  ${f.where}  ${f.rule}${f.text ? `  ${f.text}` : ""}  (commit ${f.commit})`);
console.error(`
Remove them from the commits (and rotate any real secret). If a finding is a false positive,
add "factory:allow-secret" to that line or a regex to .claude-factory/secret-allow.`);
process.exit(1);
